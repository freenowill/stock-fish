# StockFish 配置
LLM_API_KEY="your-deepseek-api-key"
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash

# Longbridge 长桥 (港美股 OpenAPI)
# LONGBRIDGE_APP_KEY=your-app-key
# LONGBRIDGE_APP_SECRET=your-app-secret
# LONGBRIDGE_ACCESS_TOKEN=your-access-token
# LONGBRIDGE_REGION=cn  # cn|hk, 提升大陆连接稳定性
# LONGBRIDGE_PRIORITY=4  # 数据源优先级，默认 5

# Tushare A 股数据
TUSHARE_TOKEN="your-tushare-token"

# Zep（用于 MiroFish 图记忆）
ZEP_API_KEY="your-zep-api-key"

# Flask
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 数据后端（mock / akshare / tushare / advanced）
STOCK_BACKEND=advanced

# 搜索 API Key
TAVILY_API_KEY=your-tavily-api-key
SEARXNG_PUBLIC_INSTANCES_ENABLED=false

# 缩短数据源超时 + 调整优先级（境外环境东方财富较慢）
EFINANCE_CALL_TIMEOUT=5
EFINANCE_PRIORITY=5
YFINANCE_PRIORITY=0
PYTDX_PRIORITY=2
AKSHARE_PRIORITY=4
BAOSTOCK_PRIORITY=3

# 实时行情优先级：腾讯最快，新浪被403不可用
REALTIME_SOURCE_PRIORITY=tencent,tushare,efinance,akshare_em

# MiroFish 地址（Docker 内用服务名，跨机器用 IP）
MIROFISH_HOST=mirofish
MIROFISH_PORT=5001

# OASIS 模拟参数
OASIS_DEFAULT_MAX_ROUNDS=20
OASIS_SIMULATION_AGENT_COUNT=15

# Qlib 数据下载代理（可选，socks5 代理加速 GitHub 下载）
# QLIB_DATA_PROXY=socks5://192.168.31.123:46590

# ── 飞书 Bot ──
# LARK_APP_ID=cli_xxxxxxxx
# LARK_APP_SECRET=xxxxxxxx
# LARK_BOT_NAME=StockFish
# STOCKFISH_API_URL=http://127.0.0.1:8000  # Docker 内改为 http://stockfish:8000
